// RUN: %execute "%s" | %FileCheck %s

// CHECK:       1
// CHECK-NEXT:  2
// CHECK-NEXT:  1
// CHECK-NEXT:  2
// CHECK-NEXT:  3
// CHECK-NEXT:  4
// CHECK-NEXT:  5
// CHECK-NEXT:  1
// CHECK-NEXT:  2

import "io"

get_tuple: () -> (i64, i64) = {
    return (1, 2);
}

print_tuple: (tuple: (i64, i64)) -> () = {
    println_i64(tuple.0);
    println_i64(tuple.1);
}

main: () -> i64 = {
    a: i64 = get_tuple().0;
    b: i64 = get_tuple().1;

    println_i64(a);
    println_i64(b);

    println_i64((a, b).0);
    println_i64((a, b).1);

    print_tuple((3, 4));

    c: i64 = (5, 6).0;

    println_i64(c);


    if ((true, false).0) {
        println_i64(1);
    } else {
        println_i64(2);
    }

    if ((true, false).1) {
        println_i64(1);
    } else {
        println_i64(2);
    }

    return 0;
}